  "permissions": [
    {
      "id": "subject.planeacion.tickets.read",
      "label": "Ver Tickets"
    },
    {
      "id": "subject.planeacion.tickets.write",
      "label": "Editar Tickets"
    },
    {
      "id": "subject.planeacion.planeacion-proyectos.read",
      "label": "Ver Proyectos"
    },
    {
      "id": "subject.planeacion.planeacion-proyectos.write",
      "label": "Editar Proyectos"
    },
    {
      "id": "subject.planeacion.planeacion-mis-tareas.read",
      "label": "Ver Mis tareas"
    },
    {
      "id": "subject.planeacion.planeacion-mis-tareas.write",
      "label": "Editar Mis tareas"
    },
    {
      "id": "subject.planeacion.planeacion-proyectos-task.read",
      "label": "Ver Tareas de proyecto"
    },
    {
      "id": "subject.planeacion.planeacion-proyectos-task.write",
      "label": "Editar Tareas de proyecto"
    }
  ],
  "menu": [
    {
      "id": "planeacion.root",
      "label": "Soporte y planeación",
      "order": 0,
      "children": [
        {
          "id": "planeacion.tickets",
          "label": "Tickets",
          "pageId": "planeacion.tickets",
          "order": 0,
          "path": "tickets",
          "permission": "subject.planeacion.tickets.read",
          "icon": "document"
        },
        {
          "id": "planeacion.planeacion-proyectos",
          "label": "Proyectos",
          "pageId": "planeacion.planeacion-proyectos",
          "order": 0,
          "path": "planeacion-proyectos",
          "permission": "subject.planeacion.planeacion-proyectos.read",
          "icon": "document"
        },
        {
          "id": "planeacion.planeacion-mis-tareas",
          "label": "Mis tareas",
          "pageId": "planeacion.planeacion-mis-tareas",
          "order": 1,
          "path": "planeacion-mis-tareas",
          "permission": "subject.planeacion.planeacion-mis-tareas.read",
          "icon": "document"
        },
        {
          "id": "planeacion.planeacion-proyectos-task",
          "label": "Tareas de proyecto",
          "pageId": "planeacion.planeacion-proyectos-task",
          "order": 2,
          "path": "planeacion-proyectos-task",
          "permission": "subject.planeacion.planeacion-proyectos-task.read",
          "icon": "document"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "planeacion.tickets",
      "path": "tickets",
      "permission": "subject.planeacion.tickets.read",
      "leaf": {
        "kind": "crud",
        "appBase": "tickets",
        "icon": "fa-ticket",
        "listHeaders": {
          "es": {
            "name": "Nombre",
            "state": "Estado",
            "ref": "Referencia"
          }
        },
        "permission": "subject.planeacion.tickets.read"
      }
    },
    {
      "id": "planeacion.planeacion-proyectos",
      "path": "planeacion-proyectos",
      "permission": "subject.planeacion.planeacion-proyectos.read",
      "leaf": {
        "kind": "crud",
        "appBase": "planeacion-proyectos",
        "icon": "fa-diagram-project",
        "listHeaders": {
          "es": {
            "name": "Nombre",
            "status": "Estado",
            "priority": "Prioridad",
            "start_date": "Inicio",
            "due_date": "Entrega",
            "progress_percentage": "Avance"
          }
        },
        "permission": "subject.planeacion.planeacion-proyectos.read"
      }
    },
    {
      "id": "planeacion.planeacion-mis-tareas",
      "path": "planeacion-mis-tareas",
      "permission": "subject.planeacion.planeacion-mis-tareas.read",
      "leaf": {
        "kind": "crud",
        "appBase": "planeacion-mis-tareas",
        "icon": "fa-list-check",
        "listHeaders": {
          "es": {
            "name": "Nombre",
            "state": "Estado",
            "priority": "Prioridad",
            "due_date": "Entrega"
          }
        },
        "permission": "subject.planeacion.planeacion-mis-tareas.read"
      }
    },
    {
      "id": "planeacion.planeacion-proyectos-task",
      "path": "planeacion-proyectos-task",
      "permission": "subject.planeacion.planeacion-proyectos-task.read",
      "leaf": {
        "kind": "crud",
        "appBase": "planeacion-proyectos-task",
        "icon": "fa-clipboard-list",
        "listHeaders": {
