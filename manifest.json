  "storage": {
    "domain": "shared-nox-postgres",
    "files": false
  },
  "resources": {
    "tickets": "tickets",
    "planeacion-proyectos": "planeacion-proyectos",
    "planeacion-mis-tareas": "planeacion-mis-tareas",
    "planeacion-proyectos-task": "planeacion-proyectos-task"
  },
  "manifestVersion": 1,
  "$schema": "https://schemas.opus-perpetuus.dev/imperium/kirlet-manifest/1.0.json"
}
